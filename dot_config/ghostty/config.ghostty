font-family = monospace

window-padding-x = 10
window-padding-y = 8,0
window-padding-balance = true
window-padding-color = extend
background-opacity = 0.93
# background-opacity = 1
gtk-single-instance = false

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
scrollback-limit = 10000000

# Generated by the native Omarchy theme engine. The optional include keeps the
# terminal usable before the desktop core has initialized its first theme.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# The display widget owns the normal font size. Omarchy deliberately maps its
# shell size in pixels to terminal points (12px -> 9pt), so the two numbers are
# not expected to match. This generated file is mutable machine state and is
# intentionally outside chezmoi.
config-file = ?"~/.local/state/desktop-core/ghostty-font-size.conf"

# Ghostty processes every config-file after this parent file, in declaration
# order. Put deliberate per-machine exceptions here; this final include wins
# over both the theme and the display widget.
config-file = ?"~/.config/ghostty/overrides.ghostty"
