{
  "version": 1,
  "idle": {
    "screensaver": 86400,
    "lock": 300
  },
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.clipboard",
    "omarchy.dev-gallery",
    "omarchy.disk-speedtest",
    "omarchy.emojis",
    "omarchy.reminders",
    "omarchy.speedtest"
  ],
  "bar": {
    "id": "omarchy.bar",
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "desktop.power-menu",
          "type": "command",
          "exec": "~/.local/bin/desktop-power-status",
          "interval": 3600,
          "onClick": "~/.local/bin/power-menu",
          "tooltip": "Power and session",
          "fontSize": 15
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "desktop.stable-tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": []
}
