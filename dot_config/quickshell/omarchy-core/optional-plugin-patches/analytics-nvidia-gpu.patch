+  function parseGpuStats(raw) {
+    var line = String(raw).trim().split("\n")[0]
+    var values = line.split(",")
+    if (values.length < 4) {
+      root.gpuAvailable = false
+      return
+    }
+
+    var utilization = parseFloat(values[0])
+    var used = parseFloat(values[1])
+    var total = parseFloat(values[2])
+    var temperature = parseFloat(values[3])
+    if (!isFinite(utilization) || !isFinite(used) || !isFinite(total) || !isFinite(temperature)) {
+      root.gpuAvailable = false
+      return
+    }
+
+    root.gpuPercent = utilization
+    root.gpuUsage = Math.round(utilization) + "%"
+    root.gpuTooltip = "GPU " + Math.round(utilization) + "% · VRAM " + Math.round(used)
+      + " MiB / " + Math.round(total) + " MiB · " + Math.round(temperature) + "°C"
+    root.gpuAvailable = true
+  }
