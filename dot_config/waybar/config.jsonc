{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 8,
    "modules-left": ["hyprland/workspaces", "hyprland/workspaces#scratchpad", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "idle_inhibitor", "bluetooth", "pulseaudio", "network", "cpu", "memory", "custom/gpu", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "active-only": false,
        "all-outputs": false
    },
    "hyprland/workspaces#scratchpad": {
        "format": "scratch",
        "show-special": true,
        "special-visible-only": false,
        "all-outputs": false,
        "ignore-workspaces": ["^[0-9]+$", "^desktop$"]
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 60,
        "separate-outputs": true
    },
    "clock": {
        "interval": 1,
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6,
        "show-passive-items": true
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Automatic locking inhibited",
        "tooltip-format-deactivated": "Automatic locking enabled"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "format-no-controller": "",
        "tooltip-format": "Bluetooth: {status}\nLeft click: manage devices\nRight click: toggle power",
        "tooltip-format-connected": "Bluetooth: {status}\n{device_enumerate}\nLeft click: manage devices\nRight click: toggle power",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "env GTK_THEME=Adwaita:dark blueman-manager",
        "on-click-right": "$HOME/.config/waybar/scripts/toggle-bluetooth"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\nLeft click: manage connections\nRight click: toggle Wi-Fi",
        "on-click": "networkmanager_dmenu",
        "on-click-right": "$HOME/.config/waybar/scripts/toggle-wifi"
    },
    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip-format": "CPU usage: {usage}%",
        "on-click": "ghostty -e btop --config $HOME/.config/btop/waybar.conf --preset 1"
    },
    "memory": {
        "interval": 2,
        "format": "󰘚 {percentage}%",
        "tooltip-format": "Memory: {used:0.1f} GiB / {total:0.1f} GiB",
        "on-click": "ghostty -e btop --config $HOME/.config/btop/waybar.conf --preset 2"
    },
    "custom/gpu": {
        "exec": "$HOME/.config/waybar/scripts/gpu-status",
        "return-type": "json",
        "interval": 2,
        "on-click": "ghostty -e btop --config $HOME/.config/btop/waybar.conf --preset 3"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power and session",
        "on-click": "$HOME/.local/bin/power-menu"
    }
}
