// Waybar — macOS menu bar inspired layout
// Signature move: nothing is centered (macOS never centers menu bar items),
// workspaces become small Mission-Control-style dots next to the logo, and
// the clock joins the status icons on the far right.
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces", "hyprland/workspaces#scratchpad", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["custom/idle-inhibitor", "bluetooth", "custom/wifi", "pulseaudio", "cpu", "memory", "custom/gpu", "tray", "clock", "custom/power"],

    "custom/apple": {
        "format": "\uf179",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/power-menu"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "active-only": false,
        "all-outputs": false
    },
    "hyprland/workspaces#scratchpad": {
        "format": "scratch",
        "show-special": true,
        "special-visible-only": false,
        "all-outputs": false,
        "ignore-workspaces": ["^[0-9]+$", "^desktop$"]
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },

    "clock": {
        "interval": 1,
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10,
        "show-passive-items": true
    },

    "custom/idle-inhibitor": {
        "exec": "$HOME/.config/waybar/scripts/idle-inhibitor status",
        "return-type": "json",
        "interval": 2,
        "on-click": "$HOME/.config/waybar/scripts/idle-inhibitor toggle"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip-format": "Bluetooth: {status}\nLeft click: manage devices\nRight click: toggle power",
        "tooltip-format-connected": "Bluetooth: {status}\n{device_enumerate}\nLeft click: manage devices\nRight click: toggle power",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "env GTK_THEME=Adwaita:dark blueman-manager",
        "on-click-right": "$HOME/.config/waybar/scripts/toggle-bluetooth"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "interface": "wlan0",
        "rfkill": true,
        "interval": 2,
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-linked": "󰤟",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤭",
        "tooltip-format-wifi": "{essid}\n{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\nLeft click: manage connections\nRight click: toggle Wi-Fi",
        "tooltip-format-disconnected": "Wi-Fi disconnected\nLeft click: manage connections\nRight click: toggle Wi-Fi",
        "tooltip-format-disabled": "Wi-Fi disabled\nLeft click: enable Wi-Fi\nRight click: manage connections",
        "on-click": "networkmanager_dmenu",
        "on-click-right": "$HOME/.config/waybar/scripts/toggle-wifi"
    },
    "custom/wifi": {
        "exec": "$HOME/.config/waybar/scripts/wifi-status",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "exec-on-event": true,
        "on-click": "networkmanager_dmenu",
        "on-click-right": "$HOME/.config/waybar/scripts/toggle-wifi"
    },
    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip-format": "CPU usage: {usage}%",
        "on-click": "ghostty -e btop --config $HOME/.config/btop/waybar.conf --preset 1"
    },
    "memory": {
        "interval": 2,
        "format": "󰘚 {percentage}%",
        "tooltip-format": "Memory: {used:0.1f} GiB / {total:0.1f} GiB",
        "on-click": "ghostty -e btop --config $HOME/.config/btop/waybar.conf --preset 2"
    },
    "custom/gpu": {
        "exec": "$HOME/.config/waybar/scripts/gpu-status",
        "return-type": "json",
        "interval": 2,
        "on-click": "ghostty -e btop --config $HOME/.config/btop/waybar.conf --preset 3"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power and session",
        "on-click": "$HOME/.local/bin/power-menu"
    }
}
