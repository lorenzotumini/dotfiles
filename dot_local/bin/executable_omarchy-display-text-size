#!/bin/bash
set -euo pipefail

# Local desktop-core adapter for Omarchy's interface-size control. Monitor
# scaling remains the only global DPI control; this command coordinates the
# shell, terminals, and launcher without multiplying GTK application scale.
# Interactive state belongs under ~/.local/state; managed application configs
# only import the generated fragments and are never edited by this command.
# Omarchy's stock conversion is retained: 12 shell px maps to 9 terminal pt.

MIN=9
MAX=20
SHELL_DEFAULT_PX=12
TERM_DEFAULT_PT=9
GKEY_SCHEMA=org.gnome.desktop.interface
GKEY_NAME=text-scaling-factor

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/desktop-core
size_state=$state_dir/text-size
shell_config=$HOME/.config/omarchy/shell.toml
ghostty_fragment=$state_dir/ghostty-font-size.conf
alacritty_fragment=$state_dir/alacritty-font-size.toml
fuzzel_fragment=$state_dir/fuzzel-font-size.ini
fragments_initialized=$state_dir/text-size-fragments-v1

usage() {
  echo "Usage: omarchy-display-text-size [size|reset|--sync]"
  echo "  (no args)  print the interface size, terminal mapping, and effective Ghostty size"
  echo "  <size>     set interface/launcher px and mapped terminal pt ($MIN-$MAX)"
  echo "  reset      return to Omarchy's 12px interface / 9pt terminal baseline"
}

valid_size() {
  [[ ${1:-} =~ ^[0-9]+$ ]] && (( $1 >= MIN && $1 <= MAX ))
}

write_atomic() {
  local path=$1 content=$2 tmp
  mkdir -p "${path%/*}"
  tmp=$(mktemp "${path}.tmp.XXXXXX")
  printf '%s' "$content" >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$path"
}

current_base_size() {
  [[ -f $shell_config ]] || return 0
  awk '
    /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\]([[:space:]]|$)/); next }
    in_font && /^[[:space:]]*base-size[[:space:]]*=/ {
      value = $0
      sub(/^[^=]*=[[:space:]]*/, "", value)
      sub(/[[:space:]]*(#.*)?$/, "", value)
      print value
      exit
    }
  ' "$shell_config"
}

current_size() {
  local size=""
  if [[ -r $size_state ]]; then
    read -r size <"$size_state" || true
  fi
  if ! valid_size "$size"; then
    size=$(current_base_size)
  fi
  if valid_size "$size"; then
    printf '%s\n' "$size"
  else
    printf '%s\n' "$SHELL_DEFAULT_PX"
  fi
}

set_base_size() {
  local size=$1 tmp
  mkdir -p "${shell_config%/*}"
  if [[ ! -f $shell_config ]]; then
    printf '[font]\nbase-size = %s\n' "$size" >"$shell_config"
    return
  fi

  tmp=$(mktemp "${shell_config}.tmp.XXXXXX")
  awk -v value="$size" '
    function emit() { print "base-size = " value; written = 1 }
    /^[[:space:]]*\[/ {
      if (in_font && !written) emit()
      in_font = ($0 ~ /^[[:space:]]*\[font\]([[:space:]]|$)/)
      print
      next
    }
    in_font && /^[[:space:]]*base-size[[:space:]]*=/ {
      if (!written) emit()
      next
    }
    { print }
    END {
      if (in_font && !written) emit()
      if (!written) {
        if (NR > 0) print ""
        print "[font]"
        emit()
      }
    }
  ' "$shell_config" >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$shell_config"
}

terminal_points_for() {
  awk -v size="$1" -v points="$TERM_DEFAULT_PT" -v base="$SHELL_DEFAULT_PX" \
    'BEGIN { printf "%d", int(size * points / base + 0.5) }'
}

effective_ghostty_points() {
  if command -v ghostty >/dev/null 2>&1; then
    ghostty +show-config 2>/dev/null | awk -F= '
      /^[[:space:]]*font-size[[:space:]]*=/ {
        value=$2; gsub(/[[:space:]]/, "", value); print value; exit
      }
    '
  fi
}

write_generated_fragments() {
  local size=$1 points
  points=$(terminal_points_for "$size")
  write_atomic "$ghostty_fragment" "font-size = $points
"
  write_atomic "$alacritty_fragment" "[font]
size = $points.0
"
  write_atomic "$fuzzel_fragment" "[main]
font=monospace:size=$size
"

  # Both terminals watch their imported configuration. Ghostty also accepts a
  # reload signal, which makes the change immediate for existing windows.
  pkill -SIGUSR2 ghostty 2>/dev/null || true
}

initialize_generated_fragments() {
  local size=$1 fallback_points ghostty_points alacritty_points
  fallback_points=$(terminal_points_for "$size")

  if [[ ! -e $fragments_initialized ]]; then
    ghostty_points=$(awk -F= '/^[[:space:]]*font-size[[:space:]]*=/ {
      value=$2; gsub(/[[:space:]]/, "", value); print value; exit
    }' "$HOME/.config/ghostty/config.ghostty" 2>/dev/null || true)
    alacritty_points=$(awk -F= '/^[[:space:]]*size[[:space:]]*=/ {
      value=$2; gsub(/[[:space:]]/, "", value); print value; exit
    }' "$HOME/.config/alacritty/alacritty.toml" 2>/dev/null || true)

    [[ $ghostty_points =~ ^[0-9]+([.][0-9]+)?$ ]] || ghostty_points=13
    [[ $alacritty_points =~ ^[0-9]+([.][0-9]+)?$ ]] || alacritty_points=15.0

    write_atomic "$ghostty_fragment" "font-size = $ghostty_points
"
    write_atomic "$alacritty_fragment" "[font]
size = $alacritty_points
"
    write_atomic "$fuzzel_fragment" "[main]
font=monospace:size=$size
"
    write_atomic "$fragments_initialized" "1
"
    pkill -SIGUSR2 ghostty 2>/dev/null || true
    return
  fi

  [[ -f $ghostty_fragment ]] || write_atomic "$ghostty_fragment" "font-size = $fallback_points
"
  [[ -f $alacritty_fragment ]] || write_atomic "$alacritty_fragment" "[font]
size = $fallback_points.0
"
  [[ -f $fuzzel_fragment ]] || write_atomic "$fuzzel_fragment" "[main]
font=monospace:size=$size
"
}

apply_size() {
  local size=$1
  valid_size "$size" || {
    echo "Size must be an integer between $MIN and $MAX (px)." >&2
    usage >&2
    exit 1
  }

  set_base_size "$size"
  write_atomic "$size_state" "$size
"
  write_generated_fragments "$size"
  write_atomic "$fragments_initialized" "1
"
  # GTK/Firefox already follow the focused monitor's Wayland scale. Keeping
  # this at 1 prevents the interface slider from scaling those apps a second
  # time (14px previously produced 1.25 * 1.1818 effective scaling).
  gsettings set "$GKEY_SCHEMA" "$GKEY_NAME" 1.0 2>/dev/null || true
}

sync_size() {
  local size
  size=$(current_size)
  set_base_size "$size"
  write_atomic "$size_state" "$size
"
  initialize_generated_fragments "$size"
  gsettings set "$GKEY_SCHEMA" "$GKEY_NAME" 1.0 2>/dev/null || true
}

case ${1:-} in
  -h|--help)
    usage
    ;;
  "")
    size=$(current_size)
    mapped_points=$(terminal_points_for "$size")
    effective_points=$(effective_ghostty_points)
    [[ -n $effective_points ]] || effective_points=$mapped_points
    printf 'interface/launcher size: %s px\ngtk text-scaling-factor: %s (monitor scale only)\nOmarchy terminal mapping: %s pt\neffective Ghostty size: %s pt\nGhostty override: ~/.config/ghostty/overrides.ghostty\n' \
      "$size" \
      "$(gsettings get "$GKEY_SCHEMA" "$GKEY_NAME" 2>/dev/null || printf 'n/a')" \
      "$mapped_points" \
      "$effective_points"
    ;;
  --sync)
    sync_size
    ;;
  reset|default)
    apply_size "$SHELL_DEFAULT_PX"
    ;;
  *)
    apply_size "$1"
    ;;
esac
