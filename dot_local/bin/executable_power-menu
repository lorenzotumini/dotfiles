#!/usr/bin/env bash
set -u

choice=$(printf '%s\n' \
  '󰌾  Lock' \
  '󰤄  Suspend' \
  '󰍃  Log out' \
  '󰜉  Restart' \
  '󰐥  Shut down' | fuzzel --dmenu --prompt='Power > ')

case "$choice" in
  '󰌾  Lock')
    omarchy-system-lock
    ;;
  '󰤄  Suspend')
    systemctl suspend
    ;;
  '󰍃  Log out')
    hyprctl --instance 0 eval 'hl.dispatch(hl.dsp.exit())'
    ;;
  '󰜉  Restart')
    systemctl reboot
    ;;
  '󰐥  Shut down')
    systemctl poweroff
    ;;
  '')
    exit 0
    ;;
esac
