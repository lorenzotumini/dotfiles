# Select the NVIDIA DRM card that owns a connected display before Hyprland
# starts. Resolve the dynamic DRM card number at every login instead of
# assuming card0/card1 or a particular PCI slot.
hypr_selected_drm=""
for hypr_status in /sys/class/drm/card[0-9]*-*/status; do
    [ -f "$hypr_status" ] || continue
    [ "$(cat "$hypr_status")" = connected ] || continue

    hypr_connector_dir=${hypr_status%/status}
    hypr_connector=${hypr_connector_dir##*/}
    hypr_card=${hypr_connector%%-*}

    [ -r "/sys/class/drm/$hypr_card/device/vendor" ] || continue
    [ "$(cat "/sys/class/drm/$hypr_card/device/vendor")" = 0x10de ] || continue

    hypr_selected_drm="/dev/dri/$hypr_card"
    break
done

if [ -n "$hypr_selected_drm" ]; then
    export AQ_DRM_DEVICES="$hypr_selected_drm"
fi

unset hypr_status hypr_connector_dir hypr_connector hypr_card hypr_selected_drm
