# Select the monitor-connected RTX 5060 Ti as Hyprland's renderer before the
# compositor starts. Resolve the dynamic DRM card number from the GPU's PCI ID
# at every login instead of assuming card0 or card1.
for hypr_gpu_card in /sys/class/drm/card[0-9]*; do
    [ -r "$hypr_gpu_card/device/vendor" ] || continue
    [ -r "$hypr_gpu_card/device/device" ] || continue
    IFS= read -r hypr_gpu_vendor < "$hypr_gpu_card/device/vendor"
    IFS= read -r hypr_gpu_device < "$hypr_gpu_card/device/device"
    if [ "$hypr_gpu_vendor" = "0x10de" ] && [ "$hypr_gpu_device" = "0x2d04" ]; then
        export AQ_DRM_DEVICES="/dev/dri/${hypr_gpu_card##*/}"
        break
    fi
done
unset hypr_gpu_card hypr_gpu_vendor hypr_gpu_device
