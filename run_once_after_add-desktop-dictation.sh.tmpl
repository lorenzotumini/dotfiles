{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -euo pipefail

# Preserve the interactive layout; add Dictation to the first indicator group.
config=$HOME/.config/omarchy/shell.json
[[ -s $config ]] || exit 0
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
jq '
  [.bar.layout | to_entries[] | .key as $section |
    .value | to_entries[] | select(.value.id == "omarchy.indicators") |
    ["bar", "layout", $section, .key]] as $groups |
  if ($groups | length) > 0 then
      getpath($groups[0]) as $widget |
      if (($widget.items // []) | length) == 0 then .
      elif ($widget.items | index("Dictation")) != null then .
      else setpath($groups[0] + ["items"]; $widget.items + ["Dictation"]) end
    else
      .bar.layout.center += [{"id": "omarchy.indicators", "items": ["Dictation"]}]
  end
' "$config" >"$tmp"
if ! cmp -s "$config" "$tmp"; then
  chmod --reference="$config" "$tmp"
  mv "$tmp" "$config"
fi
{{- end }}
