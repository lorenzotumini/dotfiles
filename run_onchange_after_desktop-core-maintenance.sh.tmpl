{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail
# The ledger makes this safe on every apply, including after future migrations.
"$HOME/.local/bin/desktop-core-maintain" migrate
"$HOME/.local/bin/desktop-core-maintain" check
"$HOME/.local/bin/desktop-core-init" --commands-only
# Read-only observation and isolated runtime checks; no automatic deployment.
if systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable --now desktop-core-runtime-check.timer desktop-core-upstream-check.timer
fi
{{- end }}
